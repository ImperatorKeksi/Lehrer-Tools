#KONSOLEH AREA START - PLEASE DO NOT EDIT MANUALLY BETWEEN THESE LINES
DirectoryIndex index.html
#KONSOLEH AREA END - PLEASE ADD MANUAL CHANGES BELOW

# ═══════════════════════════════════════════════════════════
# ⚡ SICHER & PERFORMANT - HETZNER KOMPATIBEL
# ═══════════════════════════════════════════════════════════

# 1. HTTPS ERZWINGEN (wenn SSL vorhanden)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # HTTPS erzwingen (auskommentieren wenn kein SSL!)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # WWW entfernen (bessere Performance)
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    
    # .html Extension verstecken
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L]
</IfModule>

# 2. PHP HANDLER (wichtig!)
<IfModule mod_mime.c>
    AddHandler application/x-httpd-php .php
    AddType application/x-httpd-php .php
</IfModule>

# 3. GZIP KOMPRESSION
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE text/javascript
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|ico|woff2?)$ no-gzip
</IfModule>

# 4. BROWSER CACHING
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML & PHP - kein Cache
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/x-httpd-php "access plus 0 seconds"
    
    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Bilder
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# 5. CACHE-CONTROL & SECURITY HEADERS
<IfModule mod_headers.c>
    # HTML/PHP - kein Cache
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    
    # CSS & JS - maximales Caching
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Bilder
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Fonts
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>

# 6. ETAGS DEAKTIVIEREN
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# 7. SICHERHEIT
Options -Indexes

# Dotfiles schützen
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Sensible Dateien schützen
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp|old|backup)|~)$">
    Require all denied
</FilesMatch>

# 8. MIME TYPES
<IfModule mod_mime.c>
    AddType application/javascript js
    AddType text/javascript js
    AddType application/json json
    AddType font/woff woff
    AddType font/woff2 woff2
    AddType image/svg+xml svg svgz
    AddType image/webp webp
    AddType text/css css
    AddType text/html html htm
    AddDefaultCharset UTF-8
</IfModule>

# 9. PHP OPTIMIERUNGEN - ÄNDERUNG HIER
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    
    # ⚠️ WICHTIG: Für DEBUGGING aktivieren, für Produktion deaktivieren!
    php_flag display_errors On
    php_flag display_startup_errors On
    php_value error_reporting 2147483647  # E_ALL | E_STRICT
    
    php_flag expose_php Off
    
    # Error Log für Debugging
    php_value error_log "php_errors.log"
</IfModule>

# 10. SPEZIELLE REGELN FÜR VERIFY_EMAIL.PHP - NEU HINZUGEFÜGT
<Files "verify_email.php">
    # Für diese Datei mehr Speicher und Zeit geben
    php_value max_execution_time 60
    php_value memory_limit 128M
    
    # Fehler anzeigen für Debugging
    php_flag display_errors On
    php_flag display_startup_errors On
    php_value error_reporting 2147483647
</Files>